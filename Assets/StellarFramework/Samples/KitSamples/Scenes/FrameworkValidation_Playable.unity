  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a96a7f51a8870bc43bb997d0f0d22170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u6846\u67B6\u96C6\u4E2D\u9A8C\u6536\u573A\u666F"
  summary: "\u96C6\u4E2D\u9A8C\u8BC1 ResKit\u3001UIKit\u3001HotUpdateKit \u7684\u751F\u4EA7\u63A5\u7EBF\u72B6\u6001\u3002\u5B83\u4E0D\u662F\u66FF\u4EE3\u5355\u4E2A
    Kit \u793A\u4F8B\uFF0C\u800C\u662F\u7528\u4E8E\u5FEB\u901F\u56DE\u5F52\u548C\u771F\u673A\u524D\u68C0\u67E5\u3002"
  controls: "\u5DE6\u4FA7 OnGUI \u9762\u677F\u9010\u9879\u6267\u884C\uFF1A\n1. Settings
    / HotUpdate \u914D\u7F6E\u68C0\u67E5\n2. Resources / AB / AA / RawText \u52A0\u8F7D\n3.
    UIKit \u521D\u59CB\u5316\u3001\u6253\u5F00\u9762\u677F\u3001\u538B\u529B\u6D4B\u8BD5\n4.
    \u6E05\u7406\u751F\u6210\u5BF9\u8C61\u548C\u62A5\u544A"
  setup: "\u8FD0\u884C\u524D\u5EFA\u8BAE\u5148\u901A\u8FC7 Example Builder \u751F\u6210\u6837\u4F8B\u8D44\u6E90\u3002AB
    \u4F7F\u7528\u672C\u6846\u67B6 Tools Hub \u6784\u5EFA\uFF1BAA \u4F7F\u7528 Addressables
    \u5B98\u65B9 Groups/Profiles/Build \u6216 Play Mode Script \u6A21\u62DF\u3002"
  expected: "Resources\u3001RawText\u3001UIKit \u5E94\u80FD\u76F4\u63A5\u9A8C\u6536\u3002AB
    \u82E5\u7F3A\u5C11\u6784\u5EFA\u4EA7\u7269\u4F1A\u5728 Editor \u4E0B\u56DE\u9000\u5230\u6E90
    prefab \u5E76\u7ED9\u51FA Warning\u3002AA \u53D6\u51B3\u4E8E Addressables \u662F\u5426\u5B89\u88C5\u3001address
    \u662F\u5426\u4E3A Assets/... \u4EE5\u53CA\u5185\u5BB9\u662F\u5426\u5DF2\u6784\u5EFA\u6216\u6A21\u62DF\u3002"
  notes: "\u8FDC\u7AEF AA\u3001\u771F\u673A\u4E0B\u8F7D\u548C HybridCLR dll.bytes
    \u5C5E\u4E8E\u53D1\u5E03\u94FE\u8DEF\u9A8C\u6536\uFF0C\u672C\u573A\u666F\u53EA\u63D0\u4F9B\u5165\u53E3\u3001\u8BCA\u65AD\u548C\u5931\u8D25\u53EF\u8BFB\u6027\uFF0C\u4E0D\u4F2A\u9020\u70ED\u66F4\u4EA7\u7269\u3002"
  anchorRight: 1
  area:
    serializedVersion: 2
    x: 12
    y: 12
    width: 470
    height: 690
