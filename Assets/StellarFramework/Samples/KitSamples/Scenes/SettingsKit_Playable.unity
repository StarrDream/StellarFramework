  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a96a7f51a8870bc43bb997d0f0d22170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: SettingsKit Playable
  summary: "\u6F14\u793A SettingsKit \u7684\u5B8C\u6574\u94FE\u8DEF\uFF1A\u8BBE\u7F6E\u5B9A\u4E49\u3001\u5B58\u50A8\u3001\u5373\u65F6\u5E94\u7528\u3001\u9875\u9762\u6269\u5C55\u3001\u7B56\u7565\u89E3\u8026\uFF0C\u4EE5\u53CA\u53EF\u66FF\u6362
    UI\u3002\u6837\u4F8B\u9ED8\u8BA4\u4F7F\u7528 OnGUI \u7248 SettingsMenuOverlay
    \u4F5C\u4E3A\u53C2\u8003\u5B9E\u73B0\u3002"
  controls: "F10: \u6253\u5F00\u6216\u5173\u95ED\u8BBE\u7F6E\u83DC\u5355\n1: \u64AD\u653E
    UI_Click \u6D4B\u8BD5\u97F3\u6548\n2: \u64AD\u653E Explosion 3D \u6D4B\u8BD5\u97F3\u6548\nF5:
    \u4FDD\u5B58\u5F53\u524D\u8BBE\u7F6E\nF9: \u6062\u590D\u5168\u90E8\u9ED8\u8BA4\u8BBE\u7F6E"
  setup: "\u573A\u666F\u4F1A\u81EA\u52A8\u521D\u59CB\u5316 AudioKit\u3001\u5B89\u88C5\u9ED8\u8BA4\u7684
    Gameplay / Audio / Graphics / Input / Language \u9875\u9762\uFF0C\u5E76\u8FFD\u52A0\u4E00\u4E2A
    Example \u6269\u5C55\u9875\u3002\u9ED8\u8BA4 AudioMixer \u4E0E\u6D4B\u8BD5\u97F3\u9891\u8D44\u6E90\u7531\u6784\u5EFA\u5668\u81EA\u52A8\u8865\u9F50\u3002"
  expected: "\u4FEE\u6539\u8BED\u8A00\u3001\u952E\u4F4D\u3001\u97F3\u91CF\u3001\u753B\u9762\u548C\u6269\u5C55\u8BBE\u7F6E\u540E\uFF0C\u53EF\u4EE5\u7ACB\u5373\u770B\u5230\u4E2D\u5FC3\u51C6\u661F\u3001\u5E95\u90E8\u5B57\u5E55\u3001\u53F3\u4E0A\u89D2\u72B6\u6001\u9762\u677F\u548C\u573A\u666F\u9884\u89C8\u7269\u4F53\u7684\u53D8\u5316\u3002\u4FDD\u5B58\u540E\u518D\u6B21\u8FDB\u5165\u573A\u666F\u4F1A\u8BFB\u56DE
    PlayerPrefs \u4E2D\u7684\u8BBE\u7F6E\u503C\u3002"
  notes: "\u8FD9\u4E2A\u6837\u4F8B\u523B\u610F\u4E0D\u4F9D\u8D56 UIKit\u3002\u82E5\u4F60\u7684\u9879\u76EE\u5DF2\u6709\u6B63\u5F0F
    UI\uFF0C\u53EA\u9700\u8981\u590D\u7528 SettingsKit \u7684\u5B9A\u4E49\u5C42\u3001\u5B58\u50A8\u5C42\u548C
    ApplyStrategy\uFF0C\u5373\u53EF\u66FF\u6362\u6389\u5F53\u524D\u7684 OnGUI \u5916\u89C2\u3002"
  anchorRight: 0
  area:
    serializedVersion: 2
    x: 12
    y: 12
    width: 470
    height: 690
