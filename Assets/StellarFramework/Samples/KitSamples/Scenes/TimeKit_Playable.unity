  m_Script: {fileID: 11500000, guid: a96a7f51a8870bc43bb997d0f0d22170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: TimeKit / Playable Sample
  summary: "\u4E16\u754C\u65F6\u949F\u3001Timer\u3001Catch-Up \u548C Unity timeScale
    \u89E3\u8026\u3002"
  controls: "TimeKit Sample \u9762\u677F\uFF1APause / Resume\u30011x / 10x / 60x\u3001+1
    Hour / +1 Day\uFF1B\n\u542F\u52A8\u5E76\u53D6\u6D88\u4E00\u6B21\u6027 2 \u5C0F\u65F6\u4EFB\u52A1\uFF1B\u5207\u6362
    All / Once / Latest / Skip \u540E\u70B9\u51FB +5 Hours\u3002\n\u8BBE\u7F6E Unity
    timeScale=0\uFF0C\u518D\u89C2\u5BDF TimeKit Tick\u3002"
  setup: "\u4E0D\u9700\u8981\u914D\u7F6E\u6587\u4EF6\u6216\u4E1A\u52A1\u8D44\u6E90\u3002\u8BE5\u6837\u4F8B\u53EA\u5F15\u7528
    StellarFramework.TimeKit\u3002"
  expected: "Tick\u3001Calendar\u3001TimerHandle\u3001ElapsedCount\u3001Diagnostics
    \u6B63\u5E38\u53D8\u5316\uFF1BUnity timeScale=0 \u65F6 TimeKit \u4ECD\u63A8\u8FDB\uFF0CPause
    TimeKit \u540E\u505C\u6B62\u3002\n\u505C\u6B62\u5E76\u91CD\u65B0\u8FD0\u884C\u573A\u666F\uFF0CTimer
    \u4E0D\u7D2F\u79EF\u4E14 Unity timeScale \u6062\u590D\u4E3A 1\u3002"
  notes: "\u8BE5\u573A\u666F\u7531 SampleTemplates \u4E2D\u7684\u6A21\u677F\u751F\u6210\uFF1B\u8FD0\u884C\u65F6\u811A\u672C\u4E0E\u573A\u666F\u5747\u53EF\u72EC\u7ACB\u5BFC\u51FA\u3002\n\u505C\u6B62\u8FD0\u884C\u540E\uFF0C\u6837\u4F8B\u4F1A\u6E05\u7406\u81EA\u5DF1\u7684\u8FD0\u884C\u65F6\u72B6\u6001\u3002"
  anchorRight: 0
  area:
    serializedVersion: 2
    x: 800
    y: 16
    width: 390
    height: 700
